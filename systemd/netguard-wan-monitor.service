# Project-local systemd unit template for NetGuard WAN monitoring.
# Do not install from automation. Manual install commands:
#   sudo cp /home/mtech/zeek-ids/systemd/netguard-wan-monitor.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now netguard-wan-monitor.service
#   sudo systemctl status netguard-wan-monitor.service

[Unit]
Description=NetGuard WAN Kernel Log Monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/mtech/zeek-ids
ExecStart=/home/mtech/zeek-ids/venv/bin/python -u scripts/wan_log_monitor.py
Restart=always
RestartSec=10
StandardOutput=append:/home/mtech/zeek-ids/logs/wan_monitor.log
StandardError=append:/home/mtech/zeek-ids/logs/wan_monitor.log

[Install]
WantedBy=multi-user.target
